{
  "name": "Khayyam",
  "displayName": "Khayyam Language",
  "description": "Rich language support for the Khayyam Programming Language",
  "homepage": "https://github.com/GeniusesGroup/Khayyam/",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "./icon.png",
  "galleryBanner": {
    "color": "#C80000",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GeniusesGroup/Khayyam.git"
  },
  "contributes": {
    "languages": [
      {
        "id": "khayyam",
        "aliases": ["Khayyam", "khayyam"],
        "extensions": [".kh"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "khayyam",
        "scopeName": "source.khayyam",
        "path": "./syntaxes/khayyam.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "khayyam",
        "path": "./snippets/khayyam.code-snippets"
      }
    ]
  }
}